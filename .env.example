# Copy to .env and fill in. Never commit the resulting .env.
#
#   cp .env.example .env
#
# Generate a real API_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── LLM providers ────────────────────────────────────────────────────────────
# At least one of these is required before the agent graph will run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-3-5-haiku-latest
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ── Application ──────────────────────────────────────────────────────────────
# development | testing | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required in production; the placeholder below is rejected when
# ENVIRONMENT=production, and the process refuses to start.
API_SECRET_KEY=changeme-in-production

# Serve mock integrations instead of calling real vendors.
# Must be false in production.
USE_MOCK_INTEGRATIONS=true

# Comma-separated browser origins allowed to call the API.
# Must be non-empty in production.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── Infrastructure ───────────────────────────────────────────────────────────
# The app runs without Redis; caching is simply disabled.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=604800

# Defaults are anchored to the repository directory.
# DATABASE_URL=sqlite:///./salesiq.db
# CHECKPOINT_DB_PATH=./checkpoints.sqlite

# ── External integrations (required when USE_MOCK_INTEGRATIONS=false) ────────
APOLLO_API_KEY=
HUBSPOT_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
GMAIL_CLIENT_SECRET_FILE=

# ── Observability (all optional) ─────────────────────────────────────────────
SENTRY_DSN=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=salesiq-crm

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ── Tests only ───────────────────────────────────────────────────────────────
# Redis database used by the cache regression tests.
TEST_REDIS_URL=redis://localhost:6379/15
